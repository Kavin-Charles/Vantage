# ── App ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── API ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Database ───────────────────────────────────────────
# Use docker-compose.yml for local dev (starts Postgres + Redis automatically)
DATABASE_URL=postgresql://vencore:vencore@localhost:5432/vencore
REDIS_URL=redis://localhost:6379

# ── Auth ───────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-256-bit-secret

# ── SSH Management ─────────────────────────────────────
# 32-byte hex key for encrypting stored SSH private keys
# Generate: openssl rand -hex 32
SSH_ENCRYPTION_KEY=

# ── Marketplace (vencore-platform) ────────────────────
# URL of the vencore-platform API — used to list approved plugins and validate licenses
MARKETPLACE_API_URL=https://marketplace.vencore.dev

# ── Internal ───────────────────────────────────────────
AGENT_SIGNING_SECRET=change_me_in_production
CRON_SECRET=change_me_in_production
