# ══════════════════════════════════════════════════════════
# Vencore — Environment Configuration
# ══════════════════════════════════════════════════════════
# Copy to .env and fill in values.
# All apps (web, api, worker) read from this single file.

# ── Compose / Docker ──────────────────────────────────────
# Controls which images docker compose uses.
# Dev:  leave defaults (builds from local Dockerfiles)
# Demo: ghcr.io/vencorehq/vencore-{app}:demo
# Prod: ghcr.io/vencorehq/vencore-{app}:latest
WEB_IMAGE=vencore-web:local
API_IMAGE=vencore-api:local
WORKER_IMAGE=vencore-worker:local
DB_IMAGE=timescale/timescaledb:latest-pg15

# ── Database ──────────────────────────────────────────────
DB_USER=vencore
DB_PASSWORD=vencore
DB_NAME=vencore
DATABASE_URL=postgresql://vencore:vencore@localhost:5432/vencore
REDIS_URL=redis://localhost:6379

# ── App URLs ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NODE_ENV=development

# ── Auth ──────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-256-bit-secret

# ── Clerk ─────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/pipeline
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/pipeline

# ── Stripe ────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Google OAuth ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/mail/accounts/gmail/callback

# ── SSH Management ────────────────────────────────────────
# 32-byte hex: openssl rand -hex 32
SSH_ENCRYPTION_KEY=

# ── Mail ──────────────────────────────────────────────────
# 32-byte hex: openssl rand -hex 32
MAIL_ENCRYPTION_KEY=

# ── Internal Secrets ──────────────────────────────────────
# Generate each: openssl rand -hex 32
AGENT_SIGNING_SECRET=change_me_in_production
CRON_SECRET=change_me_in_production

# ── Marketplace ───────────────────────────────────────────
MARKETPLACE_API_URL=https://marketplace.vencore.dev
MARKETPLACE_SERVICE_TOKEN=

# ── Plugin CDN ────────────────────────────────────────────
NEXT_PUBLIC_PLUGIN_CDN_URL=https://plugin-cdn.vencore.dev

# ── Plugin sandbox ────────────────────────────────────────
# How plugin backends are executed.
#   auto        (default) isolated child process, automatically falling back to
#               in-process the first time child-process fork is found to be
#               restricted by the host.
#   child       force the isolated child process (plugins stay down if fork is blocked).
#   in-process  run plugin bundles inside the API process — no fork, but no OS
#               process isolation either. Set this on hosts that block child
#               processes outright to skip the failed-fork attempt on every load.
PLUGIN_SANDBOX_MODE=auto

# ── Config ────────────────────────────────────────────────
CONFIG_PATH=../../vencore.config.json

# ── Dev-only ──────────────────────────────────────────────
DEMO_SEED=false
