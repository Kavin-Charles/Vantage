{
  "name": "@vencore/db",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc && tsc -p tsconfig.migrations.json",
    "dev": "tsc --watch",
