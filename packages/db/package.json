    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@vencore/types": "workspace:*",
    "kysely": "^0.27.0",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
