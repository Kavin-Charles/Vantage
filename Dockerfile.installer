FROM node:20-alpine AS deps
RUN corepack enable && corepack prepare pnpm@10.33.2 --activate
WORKDIR /app
ENV NODE_OPTIONS=--max-old-space-size=2048

COPY .npmrc package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json turbo.json ./
COPY packages/types/package.json       ./packages/types/package.json
COPY packages/db/package.json          ./packages/db/package.json
COPY packages/config/package.json      ./packages/config/package.json
COPY packages/api-client/package.json  ./packages/api-client/package.json
COPY packages/plugin-types/package.json    ./packages/plugin-types/package.json
COPY packages/plugin-runtime/package.json  ./packages/plugin-runtime/package.json
COPY apps/api/package.json   ./apps/api/package.json
COPY apps/web/package.json   ./apps/web/package.json
COPY apps/worker/package.json ./apps/worker/package.json
RUN pnpm install --frozen-lockfile

# ── API build ──────────────────────────────────────────────────────────────────
FROM deps AS api-builder
COPY packages/ ./packages/
COPY apps/api/  ./apps/api/
RUN pnpm --filter "@vencore/api..." build

# ── Web build ──────────────────────────────────────────────────────────────────
FROM deps AS web-builder
COPY packages/ ./packages/
COPY apps/web/  ./apps/web/
# Rewrites in next.config.ts default to http://localhost:3001 — correct for
# installer mode where API and web run in the same container.
RUN pnpm --filter "@vencore/web..." build

# ── Final image ────────────────────────────────────────────────────────────────
FROM node:20-alpine
RUN corepack enable && corepack prepare pnpm@10.33.2 --activate

# Docker CLI so the installer can exec docker/compose commands via the mounted socket
RUN apk add --no-cache docker-cli docker-cli-compose

WORKDIR /app

# API
COPY --from=api-builder /app/node_modules        ./node_modules
COPY --from=api-builder /app/packages            ./packages
COPY --from=api-builder /app/apps/api            ./apps/api

# Web
COPY --from=web-builder /app/apps/web/.next              ./apps/web/.next
COPY --from=web-builder /app/apps/web/public             ./apps/web/public
COPY --from=web-builder /app/apps/web/package.json       ./apps/web/package.json
COPY --from=web-builder /app/apps/web/next.config.ts     ./apps/web/next.config.ts
COPY --from=web-builder /app/node_modules                ./node_modules

COPY scripts/installer-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV NODE_ENV=production \
    INSTALLER_MODE=true \
    # Dummy values — installer routes never touch the DB or Redis.
    # The API schema validator requires these vars to be present.
    DATABASE_URL=postgresql://unused:unused@localhost:5432/unused \
    REDIS_URL=redis://localhost:6379 \
    JWT_SECRET=installer-mode-placeholder-not-used-for-auth

EXPOSE 3000
CMD ["/entrypoint.sh"]
