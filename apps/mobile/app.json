{
  "expo": {
    "name": "Vencore",
    "slug": "vencore",
    "version": "1.0.0",
    "scheme": "vencore",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f7f6f2"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vencore.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f7f6f2"
      },
      "package": "com.vencore.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2d6a4f"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
