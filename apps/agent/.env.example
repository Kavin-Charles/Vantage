# Required: your agent token from the Vencore dashboard (Settings > Servers > Add Server)
VENCORE_TOKEN=your_agent_token_here

# Optional: override the API endpoint (default: https://api.vencore.app)
VENCORE_API_URL=https://api.vencore.app

# Optional: reporting interval in milliseconds (default: 5000 = 5 seconds)
VENCORE_INTERVAL_MS=5000
